# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL — found in Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# Service-role secret key — Dashboard → Project Settings → API → service_role
# WARNING: Never expose this in the browser or commit it to version control.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Table that stores API keys (created by supabase-setup.sql)
SUPABASE_TABLE=api_keys

# Column in that table that holds the key value
SUPABASE_KEY_COLUMN=value

# The 'name' value of the row that contains the Gemini API key
SUPABASE_KEY_NAME=gemini

# ── CORS ─────────────────────────────────────────────────────────────────────
# Your production domain, e.g. https://political-ai.vercel.app
# Use * only during local development.
ALLOWED_ORIGIN=https://your-vercel-app.vercel.app
