<!DOCTYPE html>
<html lang="th" data-theme="dark" data-style="glass">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🏸 Badminton Club</title>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=Rajdhani:wght@400;500;600;700&family=DM+Serif+Display&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root {
  --neon: #00f5a0;
  --neon2: #00d4ff;
  --gold: #ffd700;
  --silver: #c0c0c0;
  --bronze: #cd7f32;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  width: 100%;
  height: 100%;
  font-family: 'Sarabun', sans-serif;
  background: linear-gradient(135deg, #0a0e27, #1a1a3e);
  color: #fff;
  overflow: hidden;
}

body {
  display: flex;
  align-items: center;
  justify-content: center;
}

.game-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, rgba(10, 14, 39, 0.9), rgba(26, 26, 62, 0.9));
  position: relative;
}

header {
  text-align: center;
  padding: 20px;
  background: linear-gradient(90deg, rgba(0, 245, 160, 0.1), rgba(0, 212, 255, 0.1));
  border-bottom: 2px solid var(--neon2);
}

header h1 {
  font-size: 2.5em;
  color: var(--neon2);
  text-shadow: 0 0 10px var(--neon2);
  margin-bottom: 5px;
}

.controls {
  display: flex;
  gap: 10px;
  justify-content: center;
  padding: 10px;
  background: rgba(0, 0, 0, 0.3);
  flex-wrap: wrap;
}

.btn {
  background: linear-gradient(135deg, var(--neon2), #0099ff);
  color: white;
  border: 2px solid var(--neon2);
  padding: 8px 16px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.9em;
  transition: all 0.3s;
  text-transform: uppercase;
  font-weight: bold;
}

.btn:hover {
  background: linear-gradient(135deg, var(--neon), var(--neon2));
  box-shadow: 0 0 20px var(--neon2);
  transform: scale(1.05);
}

.game-board {
  flex: 1;
  display: flex;
  gap: 20px;
  padding: 20px;
  overflow-y: auto;
}

.team {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 2px solid var(--neon2);
  border-radius: 15px;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.team-title {
  font-size: 1.5em;
  color: var(--neon2);
  margin-bottom: 15px;
  text-align: center;
  text-transform: uppercase;
  font-weight: bold;
  text-shadow: 0 0 10px var(--neon2);
}

.score-large {
  font-size: 4em;
  font-weight: bold;
  text-align: center;
  color: var(--gold);
  text-shadow: 0 0 20px var(--gold);
  margin: 20px 0;
}

.controls-btn {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.score-btn {
  flex: 1;
  background: linear-gradient(135deg, var(--neon), #00d4a0);
  border: none;
  color: black;
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  font-size: 1em;
  transition: all 0.3s;
}

.score-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 0 20px var(--neon);
}

.status {
  text-align: center;
  padding: 10px;
  margin: 10px;
  border-radius: 8px;
  font-weight: bold;
}

.status.success {
  background: rgba(100, 255, 100, 0.2);
  border: 1px solid #64ff64;
  color: #99ff99;
}

.status.error {
  background: rgba(255, 100, 100, 0.2);
  border: 1px solid #ff6464;
  color: #ff9999;
}

.status.loading {
  background: rgba(0, 212, 255, 0.2);
  border: 1px solid var(--neon2);
  color: var(--neon2);
}

.match-history {
  background: rgba(0, 0, 0, 0.3);
  border-top: 2px solid var(--neon2);
  padding: 15px;
  max-height: 150px;
  overflow-y: auto;
}

.match-history h3 {
  color: var(--neon2);
  margin-bottom: 10px;
}

.history-item {
  background: rgba(255, 255, 255, 0.05);
  padding: 8px;
  margin-bottom: 5px;
  border-radius: 5px;
  border-left: 3px solid var(--gold);
  font-size: 0.9em;
}

@media (max-width: 768px) {
  .game-board {
    flex-direction: column;
  }
  
  .score-large {
    font-size: 3em;
  }
  
  header h1 {
    font-size: 2em;
  }
}
</style>
</head>
<body>

<div class="game-container">
  <header>
    <h1>🏸 Badminton Club</h1>
    <p>Live Score Tracking with Supabase</p>
  </header>

  <div id="statusMessage"></div>

  <div class="controls">
    <button class="btn" onclick="startNewMatch()">🎮 New Match</button>
    <button class="btn" onclick="saveMatchToSupabase()">💾 Save Match</button>
    <button class="btn" onclick="loadMatchesFromSupabase()">📥 Load Matches</button>
    <button class="btn" onclick="testConnection()">🔌 Test DB</button>
    <button class="btn" onclick="resetScores()">🔄 Reset</button>
  </div>

  <div class="game-board">
    <div class="team">
      <div class="team-title">Team 1</div>
      <div class="score-large" id="score1">0</div>
      <div class="controls-btn">
        <button class="score-btn" onclick="addScore(1, 1)">+1</button>
        <button class="score-btn" onclick="addScore(1, 3)">+3</button>
        <button class="score-btn" onclick="subtractScore(1)">-1</button>
      </div>
    </div>

    <div class="team">
      <div class="team-title">Team 2</div>
      <div class="score-large" id="score2">0</div>
      <div class="controls-btn">
        <button class="score-btn" onclick="addScore(2, 1)">+1</button>
        <button class="score-btn" onclick="addScore(2, 3)">+3</button>
        <button class="score-btn" onclick="subtractScore(2)">-1</button>
      </div>
    </div>
  </div>

  <div class="match-history">
    <h3>📊 Match History</h3>
    <div id="historyContainer"></div>
  </div>
</div>

<script>
  // Supabase Setup
  const SUPABASE_URL = 'https://tprmqsfbeyqurwqpmpia.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_NeMrUwr4zRl1zRwXZcZN-g_1TkTPdxk';
  const { createClient } = window.supabase;
  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

  // Game State
  let gameState = {
    score1: 0,
    score2: 0,
    matchHistory: []
  };

  function showStatus(message, type = 'loading') {
    const statusEl = document.getElementById('statusMessage');
    statusEl.textContent = message;
    statusEl.className = `status ${type}`;
    
    if (type !== 'loading') {
      setTimeout(() => {
        statusEl.textContent = '';
        statusEl.className = '';
      }, 3000);
    }
  }

  function loadLocalGame() {
    const saved = localStorage.getItem('badmintonGame');
    if (saved) {
      gameState = JSON.parse(saved);
      updateDisplay();
    }
  }

  function saveLocalGame() {
    localStorage.setItem('badmintonGame', JSON.stringify(gameState));
  }

  function addScore(team, points) {
    if (team === 1) {
      gameState.score1 += points;
    } else {
      gameState.score2 += points;
    }
    saveLocalGame();
    updateDisplay();
  }

  function subtractScore(team) {
    if (team === 1 && gameState.score1 > 0) {
      gameState.score1--;
    } else if (team === 2 && gameState.score2 > 0) {
      gameState.score2--;
    }
    saveLocalGame();
    updateDisplay();
  }

  function updateDisplay() {
    document.getElementById('score1').textContent = gameState.score1;
    document.getElementById('score2').textContent = gameState.score2;
  }

  function startNewMatch() {
    gameState.matchHistory.push({
      score1: gameState.score1,
      score2: gameState.score2,
      date: new Date().toLocaleTimeString()
    });
    gameState.score1 = 0;
    gameState.score2 = 0;
    saveLocalGame();
    updateDisplay();
    updateHistory();
    showStatus('✅ New match started!', 'success');
  }

  function updateHistory() {
    const historyEl = document.getElementById('historyContainer');
    historyEl.innerHTML = gameState.matchHistory
      .reverse()
      .slice(0, 5)
      .map((match, i) => `
        <div class="history-item">
          Match ${i + 1}: ${match.score1} - ${match.score2} (${match.date})
        </div>
      `).join('');
  }

  async function saveMatchToSupabase() {
    try {
      showStatus('💾 Saving to database...', 'loading');
      
      const { data, error } = await supabase
        .from('matches')
        .insert([{
          player1_id: 1,
          player2_id: 2,
          score1: gameState.score1,
          score2: gameState.score2,
          status: 'completed'
        }]);

      if (error) throw error;

      showStatus('✅ Match saved!', 'success');
      startNewMatch();
    } catch (error) {
      showStatus(`❌ Save failed: ${error.message}`, 'error');
    }
  }

  async function loadMatchesFromSupabase() {
    try {
      showStatus('📥 Loading...', 'loading');
      
      const { data, error } = await supabase
        .from('matches')
        .select('*')
        .limit(5)
        .order('id', { ascending: false });

      if (error) throw error;

      if (data && data.length > 0) {
        gameState.matchHistory = data.map(m => ({
          score1: m.score1,
          score2: m.score2,
          date: new Date(m.created_at).toLocaleTimeString()
        }));
        updateHistory();
        showStatus(`✅ Loaded ${data.length} matches!`, 'success');
      } else {
        showStatus('ℹ️ No matches', 'loading');
      }
    } catch (error) {
      showStatus(`❌ Load failed: ${error.message}`, 'error');
    }
  }

  async function testConnection() {
    try {
      showStatus('🔌 Testing...', 'loading');
      
      const { data, error } = await supabase
        .from('players')
        .select('count', { count: 'exact' });

      if (error) throw error;

      showStatus('✅ Database connected!', 'success');
    } catch (error) {
      showStatus(`❌ Connection failed`, 'error');
    }
  }

  function resetScores() {
    if (confirm('Reset match?')) {
      gameState.score1 = 0;
      gameState.score2 = 0;
      saveLocalGame();
      updateDisplay();
      showStatus('🔄 Reset!', 'success');
    }
  }

  window.addEventListener('load', () => {
    loadLocalGame();
    updateHistory();
  });
</script>

</body>
</html>
